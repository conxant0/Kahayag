# Frontend settings. Copy to frontend/.env and fill in.
# Only VITE_-prefixed variables reach the browser bundle.

# Absolute base URL of the backend API. Must include the scheme; the app and the
# production build both fail fast when it does not.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API key. Required for the map to render.
# This key ships in the browser bundle and cannot be kept secret, so restrict it
# by HTTP referrer in the Google Cloud console and enable only the APIs it needs.
# Address search does not use this; only the map does.
VITE_GOOGLE_MAPS_API_KEY=
