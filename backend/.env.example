# Backend settings. Copy to backend/.env and fill in.
# Every variable is read with the APP_ prefix (see app/core/config.py).

# Set to local for local dev; production in Vercel
APP_ENV=local

# Comma-separated browser origins allowed to call the API.
APP_CORS_ORIGINS=http://localhost:5173

# AI provider: groq | disabled
APP_AI_PROVIDER=groq
APP_GROQ_API_KEY=
APP_GROQ_MODEL=llama-3.3-70b-versatile

# Geocoding (Nominatim). Set a contact string as the user agent in production.
APP_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
APP_NOMINATIM_USER_AGENT=kahayag-energy/1.0 (https://github.com/conxant0/kahayag)

# Solar irradiance provider: google | disabled
APP_SOLAR_PROVIDER=disabled
APP_GOOGLE_SOLAR_API_KEY=

# Google Static Maps key for the PDF report's satellite photo. Must be a
# server-usable key with the Static Maps API enabled (browser keys with
# referrer restrictions are rejected). Leave empty to use the keyless Esri
# World Imagery fallback.
APP_GOOGLE_MAPS_API_KEY=
